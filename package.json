{
  "name": "komastudio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-wasm.mjs && vite build && node scripts/bundle-notices.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "models": "python3 scripts/generate-figures.py",
    "test": "node --test tests/unit.test.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "android:release": "bash scripts/android-release.sh",
    "predev": "node scripts/copy-wasm.mjs",
    "bake:starter": "node tests/bake-starter.mjs",
    "test:apk-web": "node tests/apk-web.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "@pixiv/three-vrm": "3.5.5",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.176.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "133.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.51.1",
    "vite": "6.4.6"
  }
}
